parameters:
    level: max
    paths:
        - src
    excludePaths:
        - src/Support/helpers.php
    bootstrapFiles:
        - phpstan-bootstrap.php
    treatPhpDocTypesAsCertain: false
    checkMissingIterableValueType: true
    checkGenericClassInNonGenericObjectType: true
    ignoreErrors:
        -
            # phpstan-strict-rules trata cualquier cast de "mixed" como
            # sospechoso, pero coaccionar valores de configuración/DB no
            # tipados (Config::get(), filas de $wpdb) con (int)/(string)/
            # (float) es el idiomatismo estándar de WordPress y de esta
            # base de código: no son datos de usuario sin validar (esos
            # pasan por Security\Sanitizer), son valores administrados por
            # quien despliega el sitio.
            message: '#Cannot cast mixed to (int|float|string)#'
            paths:
                - src/Cache/CacheManager.php
                - src/Migrator/Migrator.php
                - src/Queue/QueueManager.php
                - src/Security/Sanitizer.php

# szepeviktor/phpstan-wordpress y phpstan/phpstan-strict-rules ya se incluyen
# automáticamente vía phpstan/extension-installer (composer.json); incluirlos
# también aquí los registra dos veces y phpstan lo rechaza.
