<?xml version="1.0"?>
<ruleset name="ND Core">
    <description>Estándares de código para el paquete nd-core.</description>

    <file>src</file>
    <file>tests</file>
    <file>nd-core.php</file>
    <file>uninstall.php</file>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <config name="testVersion" value="8.3-"/>
    <config name="minimum_supported_wp_version" value="6.5"/>

    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName"/>
        <!--
        Este monorepo usa PSR-12 (camelCase) en todo el código orientado a
        objetos, tal como exige la especificación del proyecto; WPCS asume
        el estilo snake_case procedural clásico de WordPress core/temas.
        Se desactivan aquí en vez de renombrar cientos de símbolos públicos.
        -->
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <!--
        Yoda conditions es una convención puramente estilística heredada de
        WordPress core; no aporta seguridad ni corrección en código moderno
        con tipos estrictos y no forma parte de PSR-12.
        -->
        <exclude name="WordPress.PHP.YodaConditions"/>
        <!--
        Falso positivo conocido: la sniff marca cualquier sprintf()/printf()
        no escapado, incluso cuando su resultado se usa únicamente como
        mensaje de una excepción interna (nunca se imprime al navegador).
        -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
        <!--
        $default, $namespace, $abstract, $class y $array son nombres de
        parámetro idiomáticos y perfectamente válidos en PHP 7+ (solo son
        palabras reservadas como tokens de lenguaje, no como identificadores);
        forzar alternativas menos descriptivas no aporta nada.
        -->
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
    </rule>
    <rule ref="PHPCompatibilityWP"/>
    <rule ref="Generic.Arrays.DisallowShortArraySyntax.Found">
        <severity>0</severity>
    </rule>
    <!--
    DatabaseManager::prepare() es el único punto de acceso a $wpdb->prepare()
    de toda la plataforma (ver docblock de la clase); la sniff no puede ver
    a través de esa abstracción y marca cada llamada posterior como "sin
    preparar" aunque siempre pasa por ahí.
    -->
    <rule ref="WordPress.DB.PreparedSQL.NotPrepared">
        <exclude-pattern>src/Database/DatabaseManager.php</exclude-pattern>
    </rule>
    <!--
    Los fixtures de las pruebas de integración crean/eliminan tablas de
    prueba directamente con $wpdb->query() (CREATE/DROP TABLE nunca admiten
    placeholders, con o sin dbDelta()) — mismo caso que DatabaseManager.php.
    -->
    <rule ref="WordPress.DB.PreparedSQL">
        <exclude-pattern>tests/Integration/*</exclude-pattern>
    </rule>
    <!--
    Encryption.php usa base64 como codificación de transporte para el
    resultado de sodium_crypto_secretbox, no como ofuscación.
    -->
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode">
        <exclude-pattern>src/Security/Encryption.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode">
        <exclude-pattern>src/Security/Encryption.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode">
        <exclude-pattern>tests/Unit/Security/EncryptionTest.php</exclude-pattern>
    </rule>
    <!--
    RedisCacheDriver serializa/deserializa valores de caché genéricos (no
    datos de usuario sin confiar) para un backend Redis; el riesgo de PHP
    Object Injection que advierte la sniff ya está mitigado explícitamente
    con `allowed_classes => false` en unserialize().
    -->
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_serialize">
        <exclude-pattern>src/Cache/Drivers/RedisCacheDriver.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions.serialize_unserialize">
        <exclude-pattern>src/Cache/Drivers/RedisCacheDriver.php</exclude-pattern>
    </rule>
    <!--
    Los tests unitarios (Brain Monkey, sin WordPress real) crean/limpian
    ficheros temporales de fixtures; WP_Filesystem no está disponible ni es
    apropiado fuera de un request real de WordPress.
    -->
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <!--
    Los tests colocan pequeños dobles de prueba (fixtures, listeners falsos)
    junto a la clase de test en el mismo archivo por localidad; es una
    práctica estándar de PHPUnit, distinta de mezclar clases de producción.
    -->
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
