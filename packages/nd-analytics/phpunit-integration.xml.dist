<?xml version="1.0" encoding="UTF-8"?>
<!--
Este archivo sigue el esquema de PHPUnit 9 (no el de PHPUnit 11 que usa
phpunit.xml.dist para las pruebas unitarias): las pruebas de integración
corren con un PHPUnit 9 aislado porque el arnés de pruebas de
wordpress-develop todavía no es compatible con PHPUnit 11. Ver
tools/wp-tests/README.md.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/integration-bootstrap.php"
         colors="true"
         cacheResultFile=".phpunit.cache/integration/result.cache">
    <testsuites>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory>src</directory>
        </include>
    </coverage>
</phpunit>
