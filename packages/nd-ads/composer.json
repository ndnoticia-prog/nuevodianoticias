{
    "name": "ndnoticia/nd-ads",
    "description": "Motor de publicidad propio de ND Platform: campañas, segmentación, prioridad, programación y estadísticas. AdSense, Google Ad Manager, HTML, imagen, video y patrocinados.",
    "type": "library",
    "version": "0.1.0-alpha.4",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/ndnoticia-prog/nd-platform",
    "authors": [
        {
            "name": "ND Platform Engineering",
            "homepage": "https://github.com/ndnoticia-prog"
        }
    ],
    "keywords": [
        "wordpress",
        "cms",
        "editorial",
        "nd-platform",
        "advertising"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../nd-core"
        },
        {
            "type": "path",
            "url": "../nd-builder"
        },
        {
            "type": "path",
            "url": "../nd-seo"
        },
        {
            "type": "path",
            "url": "../nd-media"
        },
        {
            "type": "path",
            "url": "../nd-discover"
        },
        {
            "type": "path",
            "url": "../nd-workflow"
        },
        {
            "type": "path",
            "url": "../nd-analytics"
        },
        {
            "type": "path",
            "url": "../nd-cache"
        },
        {
            "type": "path",
            "url": "../nd-search"
        },
        {
            "type": "path",
            "url": "../nd-ai"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require": {
        "php": ">=8.3"
    },
    "suggest": {
        "ndnoticia/nd-core": "Requerido en tiempo de ejecución (como plugin activo, no como dependencia de Composer empaquetada) para HookManager, DatabaseManager, Migrator, Sanitizer y el Container."
    },
    "require-dev": {
        "ndnoticia/nd-core": "*",
        "phpunit/phpunit": "^11.4",
        "mockery/mockery": "^1.6",
        "brain/monkey": "^2.6",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-strict-rules": "^1.6",
        "phpstan/extension-installer": "^1.4",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "NDAds\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NDAds\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "stan": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    }
}
