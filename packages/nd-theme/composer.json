{
    "name": "ndnoticia/nd-theme",
    "description": "Tema de presentación de ND Platform: layouts, bloques de front-end, modo oscuro y diseño responsive. Sin lógica de negocio propia: consume nd-core (activo como plugin) y nd-builder en tiempo de ejecución.",
    "type": "wordpress-theme",
    "version": "0.1.0-alpha.1",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/ndnoticia-prog/nd-platform",
    "authors": [
        {
            "name": "ND Platform Engineering",
            "homepage": "https://github.com/ndnoticia-prog"
        }
    ],
    "keywords": ["wordpress", "cms", "editorial", "nd-platform", "theme"],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        { "type": "path", "url": "../nd-core" },
        { "type": "path", "url": "../nd-builder" }
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require": {
        "php": ">=8.3"
    },
    "suggest": {
        "ndnoticia/nd-core": "Requerido en tiempo de ejecución (como plugin activo) para Container, HookManager y el resto de servicios de la plataforma.",
        "ndnoticia/nd-builder": "Requerido en tiempo de ejecución (empaquetado dentro de nd-core) para Block y Renderer."
    },
    "require-dev": {
        "ndnoticia/nd-core": "*",
        "ndnoticia/nd-builder": "*",
        "phpunit/phpunit": "^11.4",
        "mockery/mockery": "^1.6",
        "brain/monkey": "^2.6",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-strict-rules": "^1.6",
        "phpstan/extension-installer": "^1.4",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "NDTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NDTheme\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "stan": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    }
}
