parameters:
    level: max
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    checkMissingIterableValueType: true
    checkGenericClassInNonGenericObjectType: true
    ignoreErrors:
        -
            # Coaccionar WP_Query::get() (SearchQueryOverride) y filas de
            # $wpdb (SearchIndexRepository) con (int)/(string)/(float) es el
            # idiomatismo estándar de esta base de código; el término de
            # búsqueda siempre llega a la base de datos vía parámetros
            # ligados en DatabaseManager::select() (nunca concatenado), así
            # que la coerción de tipo no tiene implicación de seguridad. Ver
            # la misma justificación en packages/nd-core/phpstan.neon.dist.
            message: '#Cannot cast mixed to (int|float|string)#'
            paths:
                - src/Query/SearchQueryOverride.php
                - src/Repository/SearchIndexRepository.php

# szepeviktor/phpstan-wordpress y phpstan/phpstan-strict-rules ya se incluyen
# automáticamente vía phpstan/extension-installer (composer.json); incluirlos
# también aquí los registra dos veces y phpstan lo rechaza.
